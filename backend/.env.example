# =============================================================
# EventHub — Environment Variables Template
# =============================================================
# Copy this file and fill in your values:
#   Local dev:  cp .env.example .env
#   Production: cp .env.example .env.production  (then edit)
#
# FOR DOCKER COMPOSE (EC2 production):
#   Service names replace localhost:
#     mysql     → MySQL container
#     redis     → Redis container
#     rabbitmq  → RabbitMQ container
# =============================================================

# ─── MySQL ────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_mysql_password
MYSQL_DATABASE=ticketbooking

# For Docker Compose — use service name "mysql":
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/ticketbooking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# For local dev — use localhost:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/ticketbooking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_strong_mysql_password

# ─── Redis ────────────────────────────────────────────────────
# Docker Compose: redis://redis:6379
# Local dev:      redis://localhost:6379
SPRING_REDIS_URL=redis://redis:6379

# ─── RabbitMQ ─────────────────────────────────────────────────
# Docker Compose: use service name "rabbitmq"
RABBITMQ_USERNAME=eventhub
RABBITMQ_PASSWORD=your_strong_rabbitmq_password
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=eventhub
SPRING_RABBITMQ_PASSWORD=your_strong_rabbitmq_password
SPRING_RABBITMQ_VIRTUAL_HOST=/

# ─── Internal Service URLs (Docker Compose) ──────────────────
AUTH_SERVICE_URL=http://auth-service:8081
EVENT_SERVICE_URL=http://event-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083
ML_SERVICE_URL=http://ml-service:8001

# ─── CORS ─────────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ─── Mail Configuration (Brevo SMTP) ─────────────────────────
SPRING_MAIL_USERNAME=your_brevo_smtp_username
SPRING_MAIL_PASSWORD=your_brevo_smtp_password
SPRING_MAIL_FROM=noreply@yourdomain.com

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─── Brevo API ────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key

# ─── Admin Account ────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_strong_admin_password

# ─── Monitoring ───────────────────────────────────────────────
GF_ADMIN_PASSWORD=your_strong_grafana_password
